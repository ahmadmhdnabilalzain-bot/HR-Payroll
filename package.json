    "check": "pnpm lines && pnpm lines:test && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "fast-check": "4.11.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.2"
  }
}
