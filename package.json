{
  "name": "hr-payroll",
  "private": true,
  "type": "module",
  "scripts": {
    "demo": "tsx packages/engine/src/main.ts packages/engine/samples/settlement.json",
    "sif": "tsx packages/wps/src/main.ts generate",
    "sif:check": "tsx packages/wps/src/main.ts check",
    "lines": "node scripts/check-line-length.mjs",
    "lines:test": "node --test scripts/*.test.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
