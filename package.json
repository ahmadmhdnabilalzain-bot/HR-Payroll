{
  "name": "hr-payroll",
  "private": true,
  "type": "module",
  "scripts": {
    "demo": "tsx packages/engine/src/main.ts packages/engine/samples/settlement.json",
    "sif": "tsx packages/wps/src/main.ts generate",
    "sif:check": "tsx packages/wps/src/main.ts check",
    "web": "pnpm --filter @payroll/web dev",
    "web:build": "pnpm --filter @payroll/web build",
    "e2e": "pnpm --filter @payroll/web e2e",
    "api:dev": "tsx packages/api/src/main.ts",
    "api:migrate": "tsx packages/api/src/main.ts migrate",
    "lines": "node scripts/check-line-length.mjs",
    "lines:test": "node --test scripts/*.test.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --workspace-concurrency=2 --if-present test",
    "lines:ops": "node scripts/check-ops-line-length.mjs",
    "ops:test": "node --test deploy/*.test.mjs",
    "ops:typecheck": "pnpm --filter @payroll/api exec tsc --noEmit -p ../../deploy/tsconfig.json",
    "check": "pnpm lines && pnpm lines:ops && pnpm lines:test && pnpm ops:test && pnpm typecheck && pnpm ops:typecheck && pnpm test"
  },
  "devDependencies": {
    "fast-check": "4.11.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.2"
  }
}
